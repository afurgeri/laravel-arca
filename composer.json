{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "afurgeri/laravel-arca",
    "description": "Electronic invoicing for ARCA in Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "afipsdk/afip.php": "^1.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-openssl": "*",
        "illuminate/cache": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0"
    },
    "require-dev": {
        "mongodb/laravel-mongodb": "^5.11",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Arca\\": "src/"
        }
    },
    "suggest": {
        "mongodb/laravel-mongodb": "Required for the optional MongoDB storage driver (^5.11)."
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Arca\\ArcaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --compact",
        "lint": "pint --test --format agent"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
